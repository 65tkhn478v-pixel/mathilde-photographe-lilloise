# En-têtes des fichiers statiques (Cloudflare Workers Static Assets).
# Espace admin : jamais indexé, même si l'URL fuitait.
/espace-mathilde
  X-Robots-Tag: noindex, nofollow
/espace-mathilde/*
  X-Robots-Tag: noindex, nofollow

# Galeries clients : jamais indexées, ni archivées.
/galerie/*
  X-Robots-Tag: noindex, nofollow, noarchive
