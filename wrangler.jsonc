{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathilde-photographe-lilloise",
  "compatibility_date": "2026-08-01",
  // Le Worker ne traite que l'API (/api/*) ; tout le reste (site React) est
  // servi tel quel depuis dist/ par les static assets.
  "main": "worker/index.js",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mathilde-reservations",
      "database_id": "0ee2594a-7675-4422-8732-5f365d0daa65",
      "migrations_dir": "migrations"
    }
  ],
  // Galeries clients : photos privées (aperçus filigranés, finales HD).
  // Bucket non public, lu uniquement par le Worker après vérification de la
  // session. À créer sur le compte de production avant le merge dans main :
  // `npx wrangler r2 bucket create mathilde-galeries` (voir README).
  "r2_buckets": [
    {
      "binding": "GALLERY_BUCKET",
      "bucket_name": "mathilde-galeries"
    }
  ],
  // Nettoyage quotidien des galeries (RGPD) : expiration, purge D1 + R2.
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
